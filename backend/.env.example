# Plantilla de variables de entorno.
# Copia este archivo como ".env" y reemplaza los valores según tu entorno.
# El archivo .env NO debe subirse al repositorio.

# ---- Base de datos ----
DB_HOST=localhost
DB_USER=root
DB_PASSWORD=
DB_NAME=proyecto
DB_PORT=3306

# ---- Autenticación (JWT) ----
# Usa una cadena larga y aleatoria. Puedes generarla con:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=cambia_esto_por_un_secreto_largo_y_aleatorio
JWT_EXPIRES_IN=8h

# ---- Servidor ----
PORT=3000
